# Qloo Insights API (server-side only; never sent to the browser)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Postgres (Neon or any Postgres)
DATABASE_URL=
# Vercel AI Gateway, for the agent and the evaluation's assistant arm (Claude Haiku 5.5). `vercel env pull` writes it.
VERCEL_OIDC_TOKEN=
# Optional: college fairs in metro briefs (SerpApi, Google Events). Without a key the brief says fair search is off.
SERPAPI_API_KEY=
SERPAPI_MONTHLY_CAP=15
